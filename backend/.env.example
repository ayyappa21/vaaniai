# VaaniAI Backend Environment Configuration
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=*

# TTS Engine Selection: demo | indic-parler | ai4bharat | google | browser
TTS_ENGINE=demo

# Optional: AI4Bharat IndicTTS Cloud API
AI4BHARAT_API_KEY=
AI4BHARAT_ENDPOINT=https://models.ai4bharat.org/v1/tts

# Optional: HuggingFace Indic Parler-TTS Endpoint
HUGGINGFACE_API_KEY=
INDIC_PARLER_ENDPOINT=https://api-inference.huggingface.co/models/ai4bharat/indic-parler-tts

# Optional: Google Cloud Text-to-Speech API
GOOGLE_TTS_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
